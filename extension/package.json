{
  "name": "cpp-csv-diagnostics",
  "displayName": "C/C++ Historical Diagnostics",
  "version": "0.10.2",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/LijunZhang-work/code-runtime-analyzer.git"
  },
  "bugs": {
    "url": "https://github.com/LijunZhang-work/code-runtime-analyzer/issues"
  },
  "homepage": "https://github.com/LijunZhang-work/code-runtime-analyzer#readme",
  "engines": { "vscode": "^1.106.0" },
  "categories": ["Other"],
  "activationEvents": ["onLanguage:c", "onLanguage:cpp", "onUri", "onView:cppCsvDiagnostics.diagnosticsPanel"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "cppCsvDiagnostics.selectDictionary", "title": "C/C++ Diagnostics: 选择字段字典" },
      { "command": "cppCsvDiagnostics.selectDataFolder", "title": "C/C++ Diagnostics: 选择 CSV 文件夹" },
      { "command": "cppCsvDiagnostics.reloadDictionary", "title": "C/C++ Diagnostics: 加载 / 重新加载字典" },
      { "command": "cppCsvDiagnostics.reloadCsv", "title": "C/C++ Diagnostics: 加载 / 重新加载 CSV" },
      { "command": "cppCsvDiagnostics.toggleDisplay", "title": "C/C++ Diagnostics: 开始 / 结束展示" },
      { "command": "cppCsvDiagnostics.selectReplay", "title": "C/C++ Diagnostics: 选择回放时间" },
      { "command": "cppCsvDiagnostics.refresh", "title": "C/C++ Diagnostics: 刷新历史值" },
      { "command": "cppCsvDiagnostics.load2048Demo", "title": "C/C++ Diagnostics: 加载 2048 演示" },
      { "command": "cppCsvDiagnostics.openTrend", "title": "C/C++ Diagnostics: 打开字段趋势" },
      { "command": "cppCsvDiagnostics.showDataQuality", "title": "C/C++ Diagnostics: 查看 CSV 数据质量" },
      { "command": "cppCsvDiagnostics.openWebWorkbench", "title": "C/C++ Diagnostics: 打开网页工作台" },
      { "command": "cppCsvDiagnostics.runCompatibilityCheck", "title": "C/C++ Diagnostics: 重新检测编辑器兼容性" },
      { "command": "cppCsvDiagnostics.showCompatibilityReport", "title": "C/C++ Diagnostics: 查看兼容性详细解释" },
      { "command": "cppCsvDiagnostics.copyCompatibilityReport", "title": "C/C++ Diagnostics: 复制兼容性诊断信息" }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "cppCsvDiagnostics",
          "title": "历史诊断",
          "icon": "media/history.svg"
        }
      ]
    },
    "views": {
      "cppCsvDiagnostics": [
        {
          "id": "cppCsvDiagnostics.diagnosticsPanel",
          "name": "诊断功能",
          "icon": "$(history)"
        }
      ]
    },
    "configuration": {
      "title": "C/C++ Historical Diagnostics",
      "properties": {
        "cppCsvDiagnostics.backendMode": { "type": "string", "enum": ["auto", "standalone", "embedded"], "enumDescriptions": ["优先连接 EXE 安装的独立后台；没有安装或没有启动时自动使用扩展自带后台", "只连接 EXE 安装的独立后台，连接失败时明确报错", "只使用扩展自带后台"], "default": "auto", "description": "后台连接方式。一般用户保持“自动”即可；需要网页、OpenCode 与多个编辑器窗口共享服务时，再安装并启动独立后台。" },
        "cppCsvDiagnostics.backendUrl": { "type": "string", "default": "http://127.0.0.1:47831", "description": "独立后台的高级地址覆盖项。保持默认时，扩展会读取当前用户的连接记录，自动找到后台实际使用的端口和访问凭据；只有连接其他手动启动的后台时才需要修改。" }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:default": "npm run compile && node ../scripts/prepare-extension.mjs --package default",
    "package:compatible": "npm run compile && node ../scripts/prepare-extension.mjs --package compatible",
    "package:all": "npm run compile && node ../scripts/prepare-extension.mjs --package all"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.0.0"
  }
}
