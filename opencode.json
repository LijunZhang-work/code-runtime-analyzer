{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-runtime-analyzer": {
      "type": "local",
      "command": ["node.exe", "backend/src/mcp-server.mjs"],
      "cwd": ".",
      "environment": {
        "CODE_RUNTIME_ANALYZER_URL": "http://127.0.0.1:47831"
      },
      "enabled": true,
      "timeout": 15000
    }
  }
}
